QWidget#menuPrincipal {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.7,
                               fx:0.5, fy:0.5,
                               stop:0 #00a6ff,
                               stop:1 #003366);
}

QLabel {
    background: transparent;
}

QLabel#Title {
    color: black;
    font-size: 100px;
    font-family: "Luckiest Guy";
    padding-bottom: 30px;
}

QPushButton {
    background-color: #FFFF00;
    color: black;
    font-family: "Luckiest Guy";
    font-size: 18px;
    border: none;
    border-radius: 6px;
    padding: 10px 5px;
    min-height: 30px;
}
QPushButton:hover {
    background-color: #ffe066;
}
QPushButton:pressed {
    background-color: #ff8c00;
}

QLabel#Credits {
    color: darkgray;
    font-family: Arial;
}
